# One file for every tool in this hub. Copy to .env and fill in what you use.
# Empty Meta values = the ads and social agents run in DRY RUN against fake data.
# The hub (npm start) reads this file and passes it to the Python services it
# launches; each service also reads it directly when started by hand.

# ============================================================ AI providers
# Claude — console.anthropic.com → API Keys (agent chat, code generation)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_FALLBACKS=1

# OpenAI — platform.openai.com → API keys. With a key, the OpenAI text models
# appear as selectable in every chat's model picker, and images use gpt-image-2.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
SOCIAL_MAX_IMAGES_PER_DAY=20
# USD per 1M tokens, only for cost ESTIMATES from the usage OpenAI returns.
# Defaults are gpt-image-1 list prices; set the current gpt-image-2 rates from
# https://developers.openai.com/api/docs/pricing#image-generation
IMAGE_PRICE_TEXT_IN_PER_M=5
IMAGE_PRICE_IMAGE_IN_PER_M=10
IMAGE_PRICE_IMAGE_OUT_PER_M=40

# ============================================================ SEO Keyword Research
# DataForSEO — app.dataforseo.com → API Access (API password ≠ login password)
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# ============================================================ Meta app (shared)
# One developer app serves both Meta tools. App dashboard → App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Empty = the SDK / Graph default (v26.0 today).
META_API_VERSION=
META_GRAPH_VERSION=v26.0

# ============================================================ Meta Ads Agent
# Token with ads_read + ads_management + business_management (meta-ads-agent/SETUP.md).
META_ACCESS_TOKEN=
# Comma-separated ad account ids. Empty READ list = every account the token sees.
META_READ_ACCOUNT_IDS=
# Writes (create / pause / budget) ONLY here. Put the SANDBOX ad account id.
META_WRITE_ACCOUNT_IDS=
# Cap for any daily/lifetime budget the agent may set, in minor units (5000 = 50.00).
MAX_DAILY_BUDGET_MINOR=5000

# ============================================================ Social Publisher
# Token with pages_manage_posts, pages_read_engagement, pages_show_list,
# instagram_basic, instagram_content_publish, business_management (social-agent/SETUP.md).
SOCIAL_META_USER_TOKEN=
# Target ids (Page id, Instagram account id) that may be PUBLISHED to. Empty in live = none.
SOCIAL_PUBLISH_TARGETS=
SOCIAL_MAX_POSTS_PER_DAY=10
# Folder the agent may read media from (default: social-agent/media).
SOCIAL_MEDIA_DIR=

# Media hosting — Cloudflare R2 (S3-compatible). Instagram needs public URLs.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ============================================================ Cost control (all tools)
# Hard stop for API spend per calendar month, in USD. Chats and image generation
# refuse once the ledger (data/ledger.sqlite) reaches it. Ads spend is separate.
MONTHLY_API_CAP_USD=100
# Which client the services act for (client model arrives in October). Default: the agency itself.
CLIENT=agency

# ============================================================ Hub
# PORT=4400
# META_AGENT_AUTOSTART=0
# SOCIAL_AGENT_AUTOSTART=0
